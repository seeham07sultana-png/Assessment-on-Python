#Password Strength Checker 
password = input("Enter a Password")

had_upper = False
had_lower = False
had_digit = False
had_special = False

if len(password)>=8:
  had_length = True
else:
   had_length = False

for c in password:
  if c.isupper():
    had_upper = True
  elif c.islower():
    had_lower = True
  elif c.isdigit():
    had_digit = True
  elif not c.isalnum():
    had_special = True
  else:
    print("False")

if had_length and had_upper and had_lower and had_digit and had_special:
  print("Strong Password")
else:
  print("Weak")
    

